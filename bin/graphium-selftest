#!/usr/bin/env python3
"""Run Graphium's permanent non-desktop qualification authorities."""
from __future__ import annotations

import os
from pathlib import Path
import subprocess
import sys

ROOT = Path(__file__).resolve().parents[1]
ENV = os.environ.copy()
ENV["PYTHONDONTWRITEBYTECODE"] = "1"
COMMANDS = (
    [sys.executable, "-B", "-m", "unittest", "discover", "-s", "tests/behavioral", "-p", "test_*.py"],
    [sys.executable, "-B", "-m", "unittest", "discover", "-s", "tests/integration", "-p", "test_*.py"],
    [sys.executable, "-B", "tests/release/run.py", "--repo", "."],
)
for command in COMMANDS:
    result = subprocess.run(command, cwd=ROOT, env=ENV)
    if result.returncode:
        raise SystemExit(result.returncode)
raise SystemExit(0)
